# ---- Public contact details (leave blank to hide the related buttons) ----
# Defaults are set in src/config/site.ts; these override them.
# Phones in international format, comma-separated, e.g. +917010381314,+918808084949
NEXT_PUBLIC_CONTACT_PHONE=
# WhatsApp number in international format without + or spaces, e.g. 917010381314
NEXT_PUBLIC_CONTACT_WHATSAPP=
NEXT_PUBLIC_CONTACT_EMAIL=
# Canonical site URL used for SEO / Open Graph, e.g. https://www.skpulpfibre.com
NEXT_PUBLIC_SITE_URL=
